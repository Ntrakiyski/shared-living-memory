{
  "name": "shared-living-memory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create shared-living-memory-db",
    "db:migrate": "wrangler d1 execute shared-living-memory-db --file=db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute shared-living-memory-db --remote --file=db/schema.sql",
    "vectors:create": "wrangler vectorize create shared-living-memory-vectors --dimensions=384 --metric=cosine",
    "vectors:indexes": "wrangler vectorize create-metadata-index shared-living-memory-vectors --property-name=owner_user_id --type=string && wrangler vectorize create-metadata-index shared-living-memory-vectors --property-name=is_private --type=boolean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:workerd": "bash scripts/smoke-workerd.sh",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "agents": "^0.12.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.101.0"
  },
  "cloudflare": {
    "bindings": {
      "AUTH_TOKEN": {
        "description": "Your authentication token. Use a memorable phrase (like 'coffee-lover-2026') or generate a secure token with: openssl rand -base64 32. Save it - you'll need this for AI client connections!"
      }
    }
  }
}
