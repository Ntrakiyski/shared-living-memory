{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shared-living-memory",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shared-living-memory-db","database_id": "fac0f14a-718f-41e2-a2e0-ca4b644ad152"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "shared-living-memory-vectors"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV","id": "c5fa8c88b4ca4d00ae2a546b2c4ac2b7"
		}
	],
	"vars": {
		"VECTORIZE_GRACE_MS": "300000",
		"MCP_OAUTH_ENABLED": "false"
	},
	"secrets": {
		"required": ["AUTH_TOKEN"]
	},
	"assets": {
		"directory": "./public"
	},
	"triggers": {
		"crons": [
			"0 1 * * *"
		]
	},
	"env": {
		"staging": {
			"name": "shared-living-memory-staging",
			"secrets": { "required": ["AUTH_TOKEN"] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "shared-living-memory-staging-db",
					"database_id": "a8f3a16c-b9e9-4c4f-bfe6-262344d142a0"
				}
			],
			"vectorize": [
				{
					"binding": "VECTORIZE",
					"index_name": "shared-living-memory-staging-vectors"
				}
			],
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "de7e0490e13e4e7685969b4c883eb0ef"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vars": {
				"VECTORIZE_GRACE_MS": "300000",
				"MCP_OAUTH_ENABLED": "false",
				"SLM_DEPLOYMENT_ID": "slm-fractals-staging",
				"SLM_ENVIRONMENT": "staging",
				"SLM_PUBLIC_BASE_URL": "https://shared-living-memory-staging.nikolay-trakiyski.workers.dev",
				"SLM_RELEASE_ID": "REPLACE_WITH_CANDIDATE_SHA",
				"SLM_WRITE_MODE": "enabled"
			},
			"assets": {
				"directory": "./public"
			}
		}
	}
}
