{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shared-living-memory",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shared-living-memory-db","database_id": "fac0f14a-718f-41e2-a2e0-ca4b644ad152"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "shared-living-memory-vectors"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV","id": "c5fa8c88b4ca4d00ae2a546b2c4ac2b7"
		}
	],
	"vars": {
		"VECTORIZE_GRACE_MS": "300000",
		"MCP_OAUTH_ENABLED": "false"
	},
	"secrets": {
		"required": ["AUTH_TOKEN"]
	},
	"assets": {
		"directory": "./public"
	},
	"triggers": {
		"crons": [
			"0 1 * * *"
		]
	}
}
